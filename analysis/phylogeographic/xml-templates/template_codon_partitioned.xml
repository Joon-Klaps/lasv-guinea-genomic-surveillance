<?xml version="1.0" standalone="yes"?>

<!-- Generated by BEAUTi v10.5.0-beta5 Prerelease #unknown                   -->
<!--       by Alexei J. Drummond, Andrew Rambaut and Marc A. Suchard         -->
<!--       Department of Computer Science, University of Auckland and        -->
<!--       Institute of Evolutionary Biology, University of Edinburgh        -->
<!--       David Geffen School of Medicine, University of California, Los Angeles-->
<!--       http://beast.community/                                           -->
<beast version="10.5.0">


	<!-- The list of taxa to be analysed (can also include dates/ages).          -->
	<!-- ntax={{ taxa|length }}                                                                 -->
	<taxa id="taxa">
{%- for taxon in taxa %}
		<taxon id="{{ taxon.id }}">
			<date value="{{ taxon.date_value }}" direction="forwards" units="years"{% if taxon.uncertainty %} uncertainty="{{ taxon.uncertainty }}"{% endif %}/>
			<attr name="latitude">
				{{ taxon.latitude }}
			</attr>
			<attr name="longitude">
				{{ taxon.longitude }}
			</attr>

			<!-- START Multivariate diffusion model                                      -->
			<attr name="location">
				{{ taxon.latitude }} {{ taxon.longitude }}
			</attr>

			<!-- END Multivariate diffusion model                                        -->

		</taxon>
{%- endfor %}
	</taxa>



	<!-- The sequence alignment (each sequence refers to a taxon above).         -->
	<!-- ntax={{ sequences|length }} nchar={{ sequence_length }}                                                      -->
	<alignment id="alignment" dataType="nucleotide">
{%- for seq in sequences %}
		<sequence>
			<taxon idref="{{ seq.taxon_id }}"/>
			{{ seq.sequence }}
		</sequence>
{%- endfor %}
	</alignment>



	<!-- The unique patterns for codon position 1                                -->

	<!-- The unique patterns from 1 to end every 3                               -->
	<!-- npatterns=TBD                                                           -->
	<patterns id="CP1.patterns" from="1" every="3" strip="false">
		<alignment idref="alignment"/>
	</patterns>

	<!-- The unique patterns for codon position 2                                -->

	<!-- The unique patterns from 2 to end every 3                               -->
	<!-- npatterns=TBD                                                           -->
	<patterns id="CP2.patterns" from="2" every="3" strip="false">
		<alignment idref="alignment"/>
	</patterns>

	<!-- The unique patterns for codon position 3                                -->

	<!-- The unique patterns from 3 to end every 3                               -->
	<!-- npatterns=TBD                                                           -->
	<patterns id="CP3.patterns" from="3" every="3" strip="false">
		<alignment idref="alignment"/>
	</patterns>


	<!-- This is a simple constant population size coalescent model              -->
	<!-- that is used to generate an initial tree for the chain.                 -->
	<constantSize id="initialDemo" units="years">
		<populationSize>
			<parameter id="initialDemo.popSize" value="100.0"/>
		</populationSize>
	</constantSize>


	<!-- Generate a random starting tree under the coalescent process            -->
	<coalescentSimulator id="startingTree">
		<taxa idref="taxa"/>
		<constantSize idref="initialDemo"/>
	</coalescentSimulator>


	<!-- Generate a tree model                                                   -->
	<treeModel id="treeModel">
		<coalescentTree idref="startingTree"/>
		<rootHeight>
			<parameter id="treeModel.rootHeight"/>
		</rootHeight>
		<nodeHeights internalNodes="true">
			<parameter id="treeModel.internalNodeHeights"/>
		</nodeHeights>
		<nodeHeights internalNodes="true" rootNode="true">
			<parameter id="treeModel.allInternalNodeHeights"/>
		</nodeHeights>

		<!-- START Tip date sampling                                                 -->
        <!-- Insert leafHeight elements for each taxon with bad time accuracy.       -->
{%- for taxon in taxa %}
{%- if taxon.needs_tip_sampling %}
		<leafHeight taxon="{{ taxon.id }}">
			<parameter id="age({{ taxon.id }})"/>
		</leafHeight>
{%- endif %}
{%- endfor %}
		<!-- END Tip date sampling                                                   -->

	</treeModel>

	<!-- Statistic for sum of the branch lengths of the tree (tree length)       -->
	<treeLengthStatistic id="treeLength">
		<treeModel idref="treeModel"/>
	</treeLengthStatistic>

	<!-- Statistic for time of most recent common ancestor of tree               -->
	<tmrcaStatistic id="age(root)" absolute="true">
		<treeModel idref="treeModel"/>
	</tmrcaStatistic>



	<!-- Generate a gmrfSkyGridLikelihood for the Bayesian SkyGrid process       -->
	<gmrfSkyGridLikelihood id="skygrid">
		<populationSizes>

			<!-- skygrid.logPopSize is in log units unlike other popSize                 -->
			<parameter id="skygrid.logPopSize" dimension="50" value="1.0"/>
		</populationSizes>
		<precisionParameter>
			<parameter id="skygrid.precision" value="0.1" lower="0.0"/>
		</precisionParameter>
		<numGridPoints>
			<parameter id="skygrid.numGridPoints" value="49.0"/>
		</numGridPoints>
		<cutOff>
			<parameter id="skygrid.cutOff" value="500.0"/>
		</cutOff>
		<populationTree>
			<treeModel idref="treeModel"/>
		</populationTree>
	</gmrfSkyGridLikelihood>

	<!-- Define HMC for skygrid -->
	<gammaPrior id="skygrid.precision.prior" shape="0.001" scale="1000.0" offset="0.0">
		<parameter idref="skygrid.precision"/>
	</gammaPrior>
	<gmrfSkyrideGradient id="gmrfGradientPop" wrtParameter="logPopulationSizes">
		<gmrfSkyGridLikelihood idref="skygrid"/>
	</gmrfSkyrideGradient>
	<compoundParameter id="skygrid.parameters">
		<parameter idref="skygrid.precision"/>
		<parameter idref="skygrid.logPopSize"/>
	</compoundParameter>
	<gmrfSkyrideGradient id="gmrfGradientPrec" wrtParameter="precision">
		<gmrfSkyGridLikelihood idref="skygrid"/>
	</gmrfSkyrideGradient>
	<jointGradient id="joint.skygrid.precision">
		<gmrfSkyrideGradient idref="gmrfGradientPrec"/>
		<gradient>
			<gammaPrior idref="skygrid.precision.prior"/>
			<parameter idref="skygrid.precision"/>
		</gradient>
	</jointGradient>
	<compoundGradient id="full.skygrid.gradient">
		<jointGradient idref="joint.skygrid.precision"/>
		<gmrfSkyrideGradient idref="gmrfGradientPop"/>
	</compoundGradient>

	<!-- The Hamiltonian Monte Carlo relaxed clock                               -->
	<arbitraryBranchRates id="branchRates" centerAtOne="false">
		<treeModel idref="treeModel"/>
		<rates>
			<parameter id="branchRates.rates" value="0.001" lower="0.0"/>
		</rates>
		<location>
			<parameter id="branchRates.rate" value="0.001" lower="0.0"/>
		</location>
		<scale>
			<parameter id="branchRates.scale" value="1.0" lower="0.0"/>
		</scale>
	</arbitraryBranchRates>
	<distributionLikelihood id="ratesPrior">
		<data>
			<parameter idref="branchRates.rates"/>
		</data>
		<distribution>
			<logNormalDistributionModel meanInRealSpace="true">
				<mean>
					<parameter value="1.0" lower="0.0"/>
				</mean>
				<stdev>
					<parameter value="0.1" lower="0.0"/>
				</stdev>
			</logNormalDistributionModel>
		</distribution>
	</distributionLikelihood>

	<rateStatistic id="meanRate" name="meanRate" mode="mean" internal="true" external="true">
		<treeModel idref="treeModel"/>
		<arbitraryBranchRates idref="branchRates"/>
	</rateStatistic>

	<rateStatistic id="coefficientOfVariation" name="coefficientOfVariation" mode="coefficientOfVariation" internal="true" external="true">
		<treeModel idref="treeModel"/>
		<arbitraryBranchRates idref="branchRates"/>
	</rateStatistic>

	<rateCovarianceStatistic id="covariance" name="covariance">
		<treeModel idref="treeModel"/>
		<arbitraryBranchRates idref="branchRates"/>
	</rateCovarianceStatistic>


	<!-- The general time reversible (GTR) substitution model for codon position 1 -->
	<gtrModel id="CP1.gtr">
		<frequencies>
			<frequencyModel dataType="nucleotide">
				<frequencies>
					<parameter id="CP1.frequencies" value="0.25 0.25 0.25 0.25"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<rates>
			<parameter id="CP1.gtr.rates" dimension="6" value="1.0" lower="0.0"/>
		</rates>
	</gtrModel>

	<!-- The general time reversible (GTR) substitution model for codon position 2 -->
	<gtrModel id="CP2.gtr">
		<frequencies>
			<frequencyModel dataType="nucleotide">
				<frequencies>
					<parameter id="CP2.frequencies" value="0.25 0.25 0.25 0.25"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<rates>
			<parameter id="CP2.gtr.rates" dimension="6" value="1.0" lower="0.0"/>
		</rates>
	</gtrModel>

	<!-- The general time reversible (GTR) substitution model for codon position 3 -->
	<gtrModel id="CP3.gtr">
		<frequencies>
			<frequencyModel dataType="nucleotide">
				<frequencies>
					<parameter id="CP3.frequencies" value="0.25 0.25 0.25 0.25"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<rates>
			<parameter id="CP3.gtr.rates" dimension="6" value="1.0" lower="0.0"/>
		</rates>
	</gtrModel>

	<!-- site model for codon position 1                                         -->
	<siteModel id="CP1.siteModel">
		<substitutionModel>
			<gtrModel idref="CP1.gtr"/>
		</substitutionModel>
		<relativeRate weight="3.0">
			<parameter id="CP1.nu" value="0.3333333333333333" lower="0.0"/>
		</relativeRate>
		<gammaShape gammaCategories="4">
			<parameter id="CP1.alpha" value="0.5" lower="0.0"/>
		</gammaShape>
	</siteModel>

	<!-- mutation rate statistic for codon position 1                            -->
	<statistic id="CP1.mu" name="mu">
		<siteModel idref="CP1.siteModel"/>
	</statistic>

	<!-- site model for codon position 2                                         -->
	<siteModel id="CP2.siteModel">
		<substitutionModel>
			<gtrModel idref="CP2.gtr"/>
		</substitutionModel>
		<relativeRate weight="3.0">
			<parameter id="CP2.nu" value="0.3333333333333333" lower="0.0"/>
		</relativeRate>
		<gammaShape gammaCategories="4">
			<parameter id="CP2.alpha" value="0.5" lower="0.0"/>
		</gammaShape>
	</siteModel>

	<!-- mutation rate statistic for codon position 2                            -->
	<statistic id="CP2.mu" name="mu">
		<siteModel idref="CP2.siteModel"/>
	</statistic>

	<!-- site model for codon position 3                                         -->
	<siteModel id="CP3.siteModel">
		<substitutionModel>
			<gtrModel idref="CP3.gtr"/>
		</substitutionModel>
		<relativeRate weight="3.0">
			<parameter id="CP3.nu" value="0.3333333333333333" lower="0.0"/>
		</relativeRate>
		<gammaShape gammaCategories="4">
			<parameter id="CP3.alpha" value="0.5" lower="0.0"/>
		</gammaShape>
	</siteModel>

	<!-- mutation rate statistic for codon position 3                            -->
	<statistic id="CP3.mu" name="mu">
		<siteModel idref="CP3.siteModel"/>
	</statistic>

	<!-- START Multivariate diffusion model                                      -->
	<multivariateDiffusionModel id="location.diffusionModel">
		<precisionMatrix>
			<matrixParameter id="location.precision">
				<parameter id="location.precision.col1" value="0.05 0.002"/>
				<parameter id="location.precision.col2" value="0.002 0.05"/>
			</matrixParameter>
		</precisionMatrix>
	</multivariateDiffusionModel>

	<multivariateWishartPrior id="location.precisionPrior" df="2">
		<scaleMatrix>
			<matrixParameter>
				<parameter value="1.0 0.0"/>
				<parameter value="0.0 1.0"/>
			</matrixParameter>
		</scaleMatrix>
		<data>
			<parameter idref="location.precision"/>
		</data>
	</multivariateWishartPrior>

	<arbitraryBranchRates id="location.diffusion.branchRates">
		<treeModel idref="treeModel"/>
		<rates>
			<parameter id="location.diffusion.rates" lower="0.0"/>
		</rates>
	</arbitraryBranchRates>
	<distributionLikelihood id="location.diffusion.prior">
		<data>
			<parameter idref="location.diffusion.rates"/>
		</data>
		<distribution>
			<onePGammaDistributionModel>
				<shape>
					<!-- half DF                                                                 -->
					<parameter id="location.halfDF" value="0.5"/>
				</shape>
			</onePGammaDistributionModel>
		</distribution>
	</distributionLikelihood>

	<multivariateTraitLikelihood id="location.traitLikelihood" traitName="location" useTreeLength="true" scaleByTime="true" reportAsMultivariate="true" reciprocalRates="true" integrateInternalTraits="true">
		<multivariateDiffusionModel idref="location.diffusionModel"/>
		<treeModel idref="treeModel"/>
		<traitParameter>
			<parameter id="leaf.location"/>
		</traitParameter>
		<!-- west Africa is big, close to 30 so we'll be alright adding this amount of noise to it-->
		<jitter window="0.1 0.1" duplicatesOnly="true">
			<parameter idref="leaf.location"/>
		</jitter>
		<conjugateRootPrior>
			<meanParameter>
				<parameter value="0.0 0.0"/>
			</meanParameter>
			<priorSampleSize>
				<parameter value="0.000001"/>
			</priorSampleSize>
		</conjugateRootPrior>
		<arbitraryBranchRates idref="location.diffusion.branchRates"/>
	</multivariateTraitLikelihood>
	<correlation id="location.correlation" dimension1="1" dimension2="2">
		<matrixParameter idref="location.precision"/>
	</correlation>
	<matrixInverse id="location.varCovar">
		<matrixParameter idref="location.precision"/>
	</matrixInverse>
	<continuousDiffusionStatistic id="location.diffusionRate" greatCircleDistance="true">
		<multivariateTraitLikelihood idref="location.traitLikelihood"/>
	</continuousDiffusionStatistic>

	<!-- END Multivariate diffusion model                                        -->



	<!-- Collecting together relative rates for partitions                       -->
	<compoundParameter id="allNus">
		<parameter idref="CP1.nu"/>
		<parameter idref="CP2.nu"/>
		<parameter idref="CP3.nu"/>
	</compoundParameter>

		<!-- Likelihood for tree given sequence data                                 -->
<!--
	<treeDataLikelihood id="treeLikelihood" useAmbiguities="false" usePreOrder="true">
		<partition>
			<patterns idref="CP1.patterns"/>
			<siteModel idref="CP1.siteModel"/>
		</partition>
		<partition>
			<patterns idref="CP2.patterns"/>
			<siteModel idref="CP2.siteModel"/>
		</partition>
		<partition>
			<patterns idref="CP3.patterns"/>
			<siteModel idref="CP3.siteModel"/>
		</partition>
		<treeModel idref="treeModel"/>
		<arbitraryBranchRates idref="branchRates"/>
	</treeDataLikelihood>
 -->

	<!-- Likelihood for tree given sequence data for codon position 1           -->
	<treeDataLikelihood id="CP1.treeLikelihood" useAmbiguities="false" usePreOrder="true"  scalingScheme="dynamic" delayScaling="true">
		<patterns idref="CP1.patterns"/>
		<treeModel idref="treeModel"/>
		<siteModel idref="CP1.siteModel"/>
		<arbitraryBranchRates idref="branchRates"/>
	</treeDataLikelihood>

	<!-- Likelihood for tree given sequence data for codon position 2           -->
	<treeDataLikelihood id="CP2.treeLikelihood" useAmbiguities="false" usePreOrder="true"  scalingScheme="dynamic" delayScaling="true">
		<patterns idref="CP2.patterns"/>
		<treeModel idref="treeModel"/>
		<siteModel idref="CP2.siteModel"/>
		<arbitraryBranchRates idref="branchRates"/>
	</treeDataLikelihood>


	<!-- Likelihood for tree given sequence data for codon position 3           -->
	<treeDataLikelihood id="CP3.treeLikelihood" useAmbiguities="false" usePreOrder="true"  scalingScheme="dynamic" delayScaling="true">
		<patterns idref="CP3.patterns"/>
		<treeModel idref="treeModel"/>
		<siteModel idref="CP3.siteModel"/>
		<arbitraryBranchRates idref="branchRates"/>
	</treeDataLikelihood>

	<!-- Define operators                                                        -->
	<operators id="operators" optimizationSchedule="log">
		<!-- Codon partition specific operators -->
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="CP1.gtr.rates"/>
		</deltaExchange>
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="CP2.gtr.rates"/>
		</deltaExchange>
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="CP3.gtr.rates"/>
		</deltaExchange>
		<deltaExchange delta="0.01" weight="0.2">
			<parameter idref="CP1.frequencies"/>
		</deltaExchange>
		<deltaExchange delta="0.01" weight="0.2">
			<parameter idref="CP2.frequencies"/>
		</deltaExchange>
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="CP3.frequencies"/>
		</deltaExchange>
		<scaleOperator scaleFactor="0.75" weight="0.2">
			<parameter idref="CP1.alpha"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="0.2">
			<parameter idref="CP2.alpha"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="CP3.alpha"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="branchRates.rate"/>
		</scaleOperator>
		<hamiltonianMonteCarloOperator weight="1" nSteps="4" stepSize="0.01" autoOptimize="true" mode="vanilla" gradientCheckCount="0" preconditioning="diagonal" preconditioningUpdateFrequency="10">
			<jointGradient>
				<hessian>
					<distributionLikelihood idref="ratesPrior"/>
					<parameter idref="branchRates.rates"/>
				</hessian>
<!--
				<branchRateGradient traitName="Sequence">
					<treeDataLikelihood idref="treeLikelihood"/>
				</branchRateGradient>
 -->
				<branchRateGradient id="CP1.branchRateGradient" traitName="Sequence">
					<treeDataLikelihood idref="CP1.treeLikelihood"/>
				</branchRateGradient>
				<branchRateGradient id="CP2.branchRateGradient" traitName="Sequence">
					<treeDataLikelihood idref="CP2.treeLikelihood"/>
				</branchRateGradient>
				<branchRateGradient id="CP3.branchRateGradient" traitName="Sequence">
					<treeDataLikelihood idref="CP3.treeLikelihood"/>
				</branchRateGradient>
			</jointGradient>
			<parameter idref="branchRates.rates"/>
			<signTransform>
				<parameter idref="branchRates.rates"/>
			</signTransform>
		</hamiltonianMonteCarloOperator>
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="branchRates.scale"/>
		</scaleOperator>
		<upDownOperator scaleFactor="0.75" weight="20">
			<up>
				<parameter idref="treeModel.allInternalNodeHeights"/>
			</up>
			<down>
				<parameter idref="branchRates.rate"/>
			</down>
		</upDownOperator>
		<deltaExchange delta="0.01" weight="3">
			<parameter idref="allNus"/>
		</deltaExchange>
		<subtreeLeap size="1.0" weight="{{ taxa|length }}">
			<treeModel idref="treeModel"/>
		</subtreeLeap>
		<fixedHeightSubtreePruneRegraft weight="{{ (taxa|length * 0.1)|round|int }}">
			<treeModel idref="treeModel"/>
		</fixedHeightSubtreePruneRegraft>
		<hamiltonianMonteCarloOperator weight="10" nSteps="20" stepSize="0.01" mode="vanilla" autoOptimize="true" gradientCheckCount="0" gradientCheckTolerance="0.1" preconditioning="none" preconditioningUpdateFrequency="100">
			<compoundGradient idref="full.skygrid.gradient"/>
			<compoundParameter idref="skygrid.parameters"/>
			<signTransform start="1" end="1">
				<compoundParameter idref="skygrid.parameters"/>
			</signTransform>
		</hamiltonianMonteCarloOperator>


{%- for taxon in taxa %}
{%- if taxon.needs_tip_sampling %}
		<uniformOperator weight="0.002">
			<parameter idref="age({{ taxon.id }})"/>
		</uniformOperator>
{%- endif %}
{%- endfor %}

		<!-- START Multivariate diffusion model operators                           -->
		<!-- <scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="location.halfDF"/>
		</scaleOperator> -->
		<scaleOperator scaleFactor="0.75" weight="30">
			<parameter idref="location.diffusion.rates"/>
		</scaleOperator>
		<precisionGibbsOperator weight="150">
			<multivariateTraitLikelihood idref="location.traitLikelihood"/>
			<multivariateWishartPrior idref="location.precisionPrior"/>
		</precisionGibbsOperator>
		<!-- END Multivariate diffusion model operators                             -->

	</operators>


	<!-- Define MCMC                                                             -->
	<mcmc id="mcmc" chainLength="500000000" autoOptimize="true" operatorAnalysis="{{ output_prefix }}.ops">
		<joint id="joint">
			<prior id="prior">
				<!-- Codon partition priors -->
				<dirichletPrior alpha="1.0" sumsTo="6.0">
					<parameter idref="CP1.gtr.rates"/>
				</dirichletPrior>
				<dirichletPrior alpha="1.0" sumsTo="6.0">
					<parameter idref="CP2.gtr.rates"/>
				</dirichletPrior>
				<dirichletPrior alpha="1.0" sumsTo="6.0">
					<parameter idref="CP3.gtr.rates"/>
				</dirichletPrior>
				<dirichletPrior alpha="1.0" sumsTo="1.0">
					<parameter idref="CP1.frequencies"/>
				</dirichletPrior>
				<dirichletPrior alpha="1.0" sumsTo="1.0">
					<parameter idref="CP2.frequencies"/>
				</dirichletPrior>
				<dirichletPrior alpha="1.0" sumsTo="1.0">
					<parameter idref="CP3.frequencies"/>
				</dirichletPrior>
				<exponentialPrior mean="0.5" offset="0.0">
					<parameter idref="CP1.alpha"/>
				</exponentialPrior>
				<exponentialPrior mean="0.5" offset="0.0">
					<parameter idref="CP2.alpha"/>
				</exponentialPrior>
				<exponentialPrior mean="0.5" offset="0.0">
					<parameter idref="CP3.alpha"/>
				</exponentialPrior>
				<dirichletPrior alpha="1.0" sumsTo="1.0">
					<parameter idref="allNus"/>
				</dirichletPrior>

				<!-- Clock model priors -->
				<ctmcScalePrior>
					<ctmcScale>
						<parameter idref="branchRates.rate"/>
					</ctmcScale>
					<treeModel idref="treeModel"/>
				</ctmcScalePrior>

				<!-- Population size priors -->
				<gammaPrior idref="skygrid.precision.prior"/>
				<gmrfSkyGridLikelihood idref="skygrid"/>

				<arbitraryBranchRates idref="branchRates"/>

				<!-- START Multivariate diffusion model priors                              -->
				<!-- <exponentialPrior mean="10.0" offset="0.0">
					<parameter idref="location.halfDF"/>
				</exponentialPrior> -->
				<distributionLikelihood idref="location.diffusion.prior"/>
				<multivariateWishartPrior idref="location.precisionPrior"/>
				<!-- END Multivariate diffusion model priors                                -->

			</prior>
			<likelihood id="likelihood">
				<!--
				<treeDataLikelihood idref="treeLikelihood"/>
				-->
				<treeDataLikelihood idref="CP1.treeLikelihood"/>
				<treeDataLikelihood idref="CP2.treeLikelihood"/>
				<treeDataLikelihood idref="CP3.treeLikelihood"/>

				<!-- START Multivariate diffusion model                                      -->
				<multivariateTraitLikelihood idref="location.traitLikelihood"/>
				<!-- END Multivariate diffusion model                                        -->

			</likelihood>
		</joint>
		<operators idref="operators"/>

		<!-- write log to screen                                                     -->
		<log id="screenLog" logEvery="100000">
			<column label="Joint" dp="4" width="12">
				<joint idref="joint"/>
			</column>
			<column label="Prior" dp="4" width="12">
				<prior idref="prior"/>
			</column>
			<column label="Likelihood" dp="4" width="12">
				<likelihood idref="likelihood"/>
			</column>
			<column label="age(root)" sf="6" width="12">
				<tmrcaStatistic idref="age(root)"/>
			</column>
			<column label="branchRates.rate" sf="6" width="12">
				<parameter idref="branchRates.rate"/>
			</column>
		</log>

		<!-- write log to file                                                       -->
		<log id="fileLog" logEvery="100000" fileName="{{ output_prefix }}.log" overwrite="false">
			<joint idref="joint"/>
			<prior idref="prior"/>
			<likelihood idref="likelihood"/>
			<parameter idref="treeModel.rootHeight"/>
			<tmrcaStatistic idref="age(root)"/>
			<treeLengthStatistic idref="treeLength"/>
			<parameter idref="skygrid.precision"/>
			<parameter idref="skygrid.logPopSize"/>
			<parameter idref="skygrid.cutOff"/>

			<!-- Codon partition parameters -->
			<parameter idref="CP1.gtr.rates"/>
			<parameter idref="CP1.frequencies"/>
			<parameter idref="CP1.alpha"/>
			<parameter idref="CP1.nu"/>
			<statistic idref="CP1.mu"/>

			<parameter idref="CP2.gtr.rates"/>
			<parameter idref="CP2.frequencies"/>
			<parameter idref="CP2.alpha"/>
			<parameter idref="CP2.nu"/>
			<statistic idref="CP2.mu"/>

			<parameter idref="CP3.gtr.rates"/>
			<parameter idref="CP3.frequencies"/>
			<parameter idref="CP3.alpha"/>
			<parameter idref="CP3.nu"/>
			<statistic idref="CP3.mu"/>

			<parameter idref="branchRates.rate"/>
			<parameter idref="branchRates.scale"/>
			<rateStatistic idref="meanRate"/>
			<rateStatistic idref="coefficientOfVariation"/>
			<rateCovarianceStatistic idref="covariance"/>

			<!-- START Multivariate diffusion model                                      -->
			<matrixParameter idref="location.precision"/>
			<correlation idref="location.correlation"/>
			<matrixInverse idref="location.varCovar"/>
			<continuousDiffusionStatistic idref="location.diffusionRate"/>
			<parameter idref="location.halfDF"/>
			<!-- END Multivariate diffusion model                                        -->

			<!-- START Tip date sampling                                                 -->
{%- for taxon in taxa %}
{%- if taxon.needs_tip_sampling %}
			<parameter idref="age({{ taxon.id }})"/>
{%- endif %}
{%- endfor %}
			<!-- END Tip date sampling                                                   -->

			<treeDataLikelihood idref="CP1.treeLikelihood"/>
			<treeDataLikelihood idref="CP2.treeLikelihood"/>
			<treeDataLikelihood idref="CP3.treeLikelihood"/>
			<arbitraryBranchRates idref="branchRates"/>

			<!-- START Multivariate diffusion model                                      -->
			<multivariateTraitLikelihood idref="location.traitLikelihood"/>
			<!-- END Multivariate diffusion model                                        -->

			<gmrfSkyGridLikelihood idref="skygrid"/>
		</log>

		<!-- write tree log to file                                                  -->
		<logTree id="treeFileLog" logEvery="100000" nexusFormat="true" fileName="{{ output_prefix }}.trees" sortTranslationTable="true">
			<treeModel idref="treeModel"/>
			<trait name="rate" tag="rate">
				<arbitraryBranchRates idref="branchRates"/>
			</trait>
			<joint idref="joint"/>

			<!-- START Ancestral state reconstruction                                    -->
			<trait name="location" tag="location">
				<multivariateTraitLikelihood idref="location.traitLikelihood"/>
			</trait>

			<!-- END Ancestral state reconstruction                                      -->

			<!-- START Multivariate diffusion model                                      -->
			<multivariateDiffusionModel idref="location.diffusionModel"/>
			<multivariateTraitLikelihood idref="location.traitLikelihood"/>
			<trait name="rate" tag="location.rate">
				<arbitraryBranchRates idref="location.diffusion.branchRates"/>
			</trait>
			<!-- END Multivariate diffusion model                                        -->

		</logTree>

	</mcmc>

	<report>
		<property name="timer">
			<mcmc idref="mcmc"/>
		</property>
	</report>

</beast>
